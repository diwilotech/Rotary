// CD Rotaract (cdrotaract.diwilo.com). Partió de CD Rotaract (Plantilla App Diwilo).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cdrotaract",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Solo se publica en su dominio. Diwilo Web la administra por service binding (RPC), sin pasar por internet.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "cdrotaract.diwilo.com", "custom_domain": true }],

  // Conserva las variables cargadas en el dashboard en cada deploy.
  "keep_vars": true,

  // En Workers Builds (WORKERS_CI=1) aplica las migraciones de D1 pendientes antes de desplegar.
  "build": {
    "command": "sh -c 'if [ -n \"$WORKERS_CI\" ]; then npx wrangler d1 migrations apply control-de-rotaract-db --remote; fi'"
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Pasan por el Worker: login y panel de cada negocio (/<dirección>), páginas del negocio (exigen sesión), API y MCP. Los archivos estáticos (css, js, íconos…) se sirven directo.
    "run_worker_first": ["/*", "!/css/*", "!/js/*", "!/icons/*", "!/assets/*", "!/manifest.json", "!/sw.js", "!/privacidad", "!/dmca", "!/404.html"]
  },

  // Sin cron: la cuenta gratuita de Workers ya usa sus 5 tareas programadas y los módulos de Rotaract no tienen tareas diarias.
  // Si se agrega una, va aquí: "triggers": { "crons": ["0 8 * * *"] },

  // Llave pública de Cloudflare Turnstile (el secret va aparte: npx wrangler secret put TURNSTILE_SECRET_KEY).
  // Esta es la de PRUEBA de Cloudflare (siempre pasa): cámbiala por la del widget de cdrotaract.diwilo.com.
  "vars": { "TURNSTILE_SITE_KEY": "0x4AAAAAAFXxFD-ScxJkbMkF" },

  // Archivos del negocio (logo y documentos), siempre con el prefijo <business_id>/.
  // Bucket de CD Rotaract.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "cdrotaract-files" }],

  "d1_databases": [
    {
      "binding": "DB",
      // Base de CD Rotaract.
      "database_name": "control-de-rotaract-db",
      "database_id": "3b5dc69a-ad40-408d-b832-41bec12e9578",
      "migrations_dir": "migrations"
    }
  ],

  // Sin secretos para Diwilo: la administración llega por RPC (export class Platform en src/index.js).

  // Módulos horizontales (Finanzas, Marketing): Worker central «Diwilo Modulos» por RPC (modulos.app.json → "centrales").
  "services": [{ "binding": "MODULOS", "service": "diwilo-modulos", "entrypoint": "Modulos" }]
}
